# ═══════════════════════════════════════════════════════════════════════════════
# Jarvis Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this to .env and fill in your actual credentials

# ── Telegram Bot ────────────────────────────────────────────────────────────────
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# ── API Bridge (Local Web UI) ───────────────────────────────────────────────────
# HTTP server configuration for web UI communication
API_BRIDGE_PORT=8000
API_BRIDGE_HOST=127.0.0.1

# ── X (Twitter) Credentials ────────────────────────────────────────────────────
# Browser-based publishing (Selenium + undetected-chromedriver)
# These credentials are used for web scraping via stealth browser
X_USERNAME=your_x_handle@example.com
X_PASSWORD=your_x_password_here
X_2FA_CODE=optional_2fa_code  # If 2FA is enabled

# ── LinkedIn Credentials ────────────────────────────────────────────────────────
# Browser-based publishing (Selenium)
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password_here

# ── Instagram (if using Graph API in future) ────────────────────────────────────
# Currently not implemented; reserved for future Graph API integration
INSTAGRAM_ACCESS_TOKEN=optional_instagram_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=optional_account_id

# ── Google Workspace (Gmail + Google Drive) ───────────────────────────────────
# OAuth 2.0 credentials for reading emails and managing docs
# Download from: https://console.cloud.google.com/credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# ── LLM (Ollama Local) ───────────────────────────────────────────────────────────
# Ollama runs locally and communicates via HTTP
# Installation: https://ollama.ai
# Default model for local inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral  # or llama2, neural-chat, etc.

# ── Memory / Vector Database (Chroma) ──────────────────────────────────────────
# Chroma stores conversation context for ≥30 days
CHROMA_DB_PATH=./memory/chroma_db
CHROMA_COLLECTION_NAME=jarvis-context

# ── Safety & Monitoring ────────────────────────────────────────────────────────
# Alert thresholds and timeouts
URGENT_KEYWORD_ALERT_TIMEOUT_SECONDS=60
ANOMALY_THRESHOLD=5  # max requests in 5-min window before flagging
HITL_APPROVAL_TIMEOUT_HOURS=24

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=./logs/jarvis.log

# ── Optional: Pinecone (if using Pinecone instead of Chroma) ──────────────────
# PINECONE_API_KEY=your_pinecone_key
# PINECONE_ENVIRONMENT=us-west1-gcp
# PINECONE_INDEX_NAME=jarvis-index

# ═══════════════════════════════════════════════════════════════════════════════
# QUICK START
# ═══════════════════════════════════════════════════════════════════════════════
#
# 1. Copy this file: cp .env.example .env
# 2. Fill in TELEGRAM_BOT_TOKEN (required to run)
# 3. Fill in X_USERNAME and X_PASSWORD (if using Twitter publishing)
# 4. Fill in LINKEDIN_EMAIL and LINKEDIN_PASSWORD (if using LinkedIn publishing)
# 5. Run: python -m jarvis.main (Telegram bot + background tasks)
# 6. In another terminal: python -m jarvis.api_bridge (Web UI API)
# 7. Connect React frontend to http://localhost:8000/api/command
#
# ═══════════════════════════════════════════════════════════════════════════════
